<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-CoreOp. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#1F5FD1</Color>
    <Color x:Key="SuiteAccentHover">#1A52B8</Color>
    <Color x:Key="SuiteAccentPressed">#15449A</Color>
    <Color x:Key="SuiteAccentText">#1A52B8</Color>
    <Color x:Key="SuiteAccentWash">#D3E3FF</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Draft. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#1B1C20</Color>
    <Color x:Key="SuiteAccentHover">#34363C</Color>
    <Color x:Key="SuiteAccentPressed">#4B4E56</Color>
    <Color x:Key="SuiteAccentText">#17181B</Color>
    <Color x:Key="SuiteAccentWash">#E4E3DE</Color>
    <Color x:Key="SuiteOnAccent">#FFFFFF</Color>
</ResourceDictionary>

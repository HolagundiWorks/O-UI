<?xml version="1.0" encoding="utf-8"?>
<!--
  The suite's neutral colours, in one place: warm paper and ink. Each app adds its own accent (SuiteAccent.Orange, .Blue or .Black.xaml).
  Accent colours are for fills and marks; text in the accent colour uses SuiteAccentText. Contrast on white: ink 17.2, ink soft 8.9.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteBackground">#F6F5F1</Color>
    <Color x:Key="SuiteSidebar">#EFEDE6</Color>
    <Color x:Key="SuiteSurface">#FFFFFF</Color>
    <Color x:Key="SuiteInk">#17181B</Color>
    <Color x:Key="SuiteInkSoft">#45484D</Color>
    <Color x:Key="SuiteEdge">#DAD7CD</Color>
    <Color x:Key="SuiteEdgeStrong">#8A877D</Color>
    <Color x:Key="SuiteHover">#ECE9DF</Color>
    <Color x:Key="SuiteDanger">#B83A26</Color>
</ResourceDictionary>

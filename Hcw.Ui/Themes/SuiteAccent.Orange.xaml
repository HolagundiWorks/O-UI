<?xml version="1.0" encoding="utf-8"?>
<!-- The accent of O-Studio. Fills and marks use SuiteAccent; text in the accent colour uses SuiteAccentText; SuiteOnAccent is the text on a fill. Generated by tools/make-variants.mjs. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SuiteAccent">#FF6B00</Color>
    <Color x:Key="SuiteAccentHover">#E65F00</Color>
    <Color x:Key="SuiteAccentPressed">#CC5500</Color>
    <Color x:Key="SuiteAccentText">#A83F00</Color>
    <Color x:Key="SuiteAccentWash">#FFDCC2</Color>
    <Color x:Key="SuiteOnAccent">#17181B</Color>
</ResourceDictionary>
